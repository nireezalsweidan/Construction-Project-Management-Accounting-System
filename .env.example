# Django development settings. Generate a unique value; do not reuse this placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase PostgreSQL connection details from the Supabase Connect dialog.
# Use either the direct connection or session pooler values supported by your network.
DB_NAME=postgres
DB_USER=replace-with-supabase-database-user
DB_PASSWORD=replace-with-supabase-database-password
DB_HOST=replace-with-supabase-database-host
DB_PORT=5432
DB_SSLMODE=require
